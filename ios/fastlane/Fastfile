default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # sync_code_signing(type: "appstore") # Uncomment when match is set up
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner")
    # upload_to_testflight # Uncomment when App Store Connect keys are ready
  end

  desc "Push a new release build to the App Store"
  lane :deploy do
    # sync_code_signing(type: "appstore")
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner")
    # upload_to_app_store # Uncomment when App Store Connect keys are ready
  end
end
